+  # Read the pipe ourselves. select() only sees the OS pipe, so pairing it
+  # with buffered readline() strands any reply that arrived in the same chunk
+  # as an earlier line (common when the system is busy), and the request
+  # times out even though the answer is already here. Leftover bytes carry
+  # over to the next request on the same process.
+  buf = getattr(proc, "rpc_buffer", b"")
+  try:
+    while True:
+      while b"\n" in buf:
+        line, buf = buf.split(b"\n", 1)
+        try:
+          message = json.loads(line)
+        except Exception:
+          continue
+        if isinstance(message, dict) and message.get("id") == request_id:
+          return message
+      remaining = deadline - time.time()
+      if remaining <= 0:
+        break
+      ready, _, _ = select.select([proc.stdout], [], [], min(remaining, 0.25))
+      if not ready:
+        continue
+      chunk = os.read(proc.stdout.fileno(), 65536)
+      if not chunk:
+        break
+      buf += chunk
+  finally:
+    proc.rpc_buffer = buf
